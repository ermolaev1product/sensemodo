# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Generated static copy (source remains out/)
/public/
/pnpm-lock.pre-analytics.yaml
/pnpm-workspace.pre-analytics.yaml

# Authored SEO runtime; locale HTML and sitemap are generated by build-seo.
!/out/
/out/*
!/out/seo.js

# Local credentials and generated artifacts
.env
.env.*
!.env.example
.dev.vars*
node_modules/
.sites-runtime/
.wrangler/
*.apk
*.aab
release-archive/
